# Measurement tools. Real values live in Vercel; never commit them.

# Meta Pixel ID (public, shipped to the browser).
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token. SERVER ONLY: never prefix with NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=

# Optional, testing only (Events Manager > Test Events). Remove after validation.
META_TEST_EVENT_CODE=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Public, shipped to the browser.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
